@model QuachXuanThinh_2310900100_de05.Models.QxtTask

@{
    ViewData["Title"] = "Xóa công việc";
}

<h1>Xóa nhân viên</h1>

<h3>Bạn chắc chắn muốn xóa nhân viên này?</h3>
<div>
    <h4>QxtEmployee</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.QxtTaskName)
        </dt>
