            @Html.DisplayFor(model => model.QxtStartDate)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.QxtTaskStatus)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.QxtTaskStatus)
        </dd>
    </dl>

    <form asp-action="QxtDelete">
        <input type="hidden" asp-for="QxtTaskId" />
