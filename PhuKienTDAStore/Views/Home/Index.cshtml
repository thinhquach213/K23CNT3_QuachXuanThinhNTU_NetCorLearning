@using System.Security.Claims
@{
    var isLoggedIn = User?.Identity?.IsAuthenticated ?? false;
    var userEmail = User?.FindFirst(ClaimTypes.Email)?.Value
                     ?? Context.Session.GetString("UserEmail");
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phụ Kiện TDA</title>
    <meta name="description" content="Phụ kiện thời trang cao cấp - Ví, túi xách, giày dép, đồng hồ, trang sức và phụ kiện thời trang">

    <link rel="icon" href="assets/img/logo.png" type="image/png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="css/style.css">

    <style>
        html {
            scroll-behavior: smooth
        }
    </style>
</head>

<body>
    <!-- ========== HEADER SECTION ========== -->
    <header class="text-white full-bleed" style="background-color: #8B0000;">
        <div class="container d-flex justify-content-between align-items-center py-3">
            <!-- Logo -->
            <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center text-decoration-none">
                <img src="~/assets/img/logo.png" alt="Logo" style="height:80px;">
                <small class="ms-3 fst-italic text-white fs-6">Phong cách tạo nên đẳng cấp</small>
            </a>

            <!-- Search -->
            <form asp-controller="SanPham" asp-action="Search" method="get" class="d-flex mx-4 flex-grow-1">
                <input class="form-control form-control-lg rounded-pill" name="q"
                       type="search" placeholder="Tìm kiếm phụ kiện...">
                <button class="btn btn-link text-white ms-n5" type="submit">
                    <i class="bi bi-search fs-5"></i>
                </button>
            </form>

            <!-- Hotline + User/Cart -->
            <div class="d-flex align-items-center">
                <a href="tel:0377749999" class="btn btn-lg text-white rounded-pill px-4 me-4"
                   style="background-color:#c7a062; font-weight:600;">
                    <i class="bi bi-telephone-fill me-2"></i> Hotline: 0377749999
                </a>

                <a asp-controller="Cart" asp-action="Index" class="text-white me-4">
                    <i class="bi bi-bag fs-4"></i>
                </a>

                @if (isLoggedIn)
                {
                    <div class="dropdown">
                        <a class="text-white dropdown-toggle text-decoration-none" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-4 me-1"></i> @userEmail
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-controller="Auth" asp-action="DangXuat">Đăng xuất</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Auth" asp-action="DangNhap" class="text-white">
                        <i class="bi bi-person fs-4"></i>
                    </a>
                }
            </div>
        </div>

        <!-- Navigation Menu -->
        <nav class="bg-white border-top">
            <div class="container d-flex align-items-center">
                <!-- Categories Dropdown -->
                <div class="dropdown position-static">
                    <a href="#" class="btn btn-lg text-white fw-bold me-5 dropdown-toggle"
                       style="background-color:#ff8c00;" id="danhmucMenu"
                       data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-list"></i> Danh mục phụ kiện
                    </a>

                    <ul class="dropdown-menu shadow mt-0 p-3" aria-labelledby="danhmucMenu">
                        <div class="d-flex">
                            <div class="me-4">
                                <h6 class="fw-bold">Ví & Thắt Lưng</h6>
                                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="1" class="nav-link text-dark me-4">Ví Nam/Nữ</a>
                                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="7" class="nav-link text-dark me-4">Thắt Lưng</a>
                            </div>
                            <div class="me-4">
                                <h6 class="fw-bold">Túi Xách & Balo</h6>
                                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="4" class="nav-link text-dark me-4">Ba Lô</a>
                                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="6" class="nav-link text-dark me-4">Túi Đeo</a>
                                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="3" class="nav-link text-dark me-4">Cặp Da</a>
                            </div>
                            <div class="me-4">
                                <h6 class="fw-bold">Du Lịch & Công Sở</h6>
                                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="2" class="nav-link text-dark me-4">Va Li</a>
                                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="5" class="nav-link text-dark me-4">Gối Tựa</a>
                            </div>
                            <div class="me-4">
                                <h6 class="fw-bold">Giày Dép & Thời Trang</h6>
                                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="8" class="nav-link text-dark me-4">Giày Dép</a>
                                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="9" class="nav-link text-dark me-4">Phụ Kiện Thời Trang</a>
                            </div>
                            <div>
                                <h6 class="fw-bold">Trang Sức & Đồng Hồ</h6>
                                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="10" class="nav-link text-dark me-4">Đồng Hồ</a>
                                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="11" class="nav-link text-dark me-4">Trang Sức</a>
                            </div>
                        </div>
                    </ul>
                </div>

                <!-- Menu Links -->
                <a asp-controller="Home" asp-action="Index" asp-fragment="flash-sale" class="btn btn-lg text-dark me-4" style="background-color: #fff9c4;">
                    <i class="bi bi-ticket-perforated"></i> Khuyến mãi
                </a>

                <a asp-controller="Home" asp-action="Index" asp-fragment="services" class="btn btn-lg text-dark me-4" style="background-color: #fff9c4;">
                    <i class="bi bi-shield"></i> Dịch vụ
                </a>

                <a asp-controller="Home" asp-action="Index" asp-fragment="footer" class="btn btn-lg text-dark me-4" style="background-color: #fff9c4;">
                    <i class="bi bi-telephone"></i> Liên hệ
                </a>
            </div>
        </nav>
    </header>

    <!-- ========== SLIDER SECTION ========== -->
    <div id="banner" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="assets/img/slider_1.jpg" class="d-block w-100" alt="Phụ kiện thời trang">
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#banner" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#banner" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>

    <!-- ========== CATEGORIES SECTION ========== -->
    <section class="categories-section">
        <div class="container">
            <div class="categories d-flex justify-content-center align-items-center mt-4">
                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="1" class="nav-link text-dark me-4">
                    <div class="category-item text-center">
                        <img src="assets/icon/cate_1.webp.jpg" alt="Ví" class="img-fluid" style="width: 90px; height: 90px;">
                        <p class="fs-5 fw-bold mt-2">Ví</p>
                    </div>
                </a>
                <div class="divider"></div>

                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="2" class="nav-link text-dark me-4">
                    <div class="category-item text-center">
                        <img src="assets/icon/cate_2.webp.jpg" alt="Va li" class="img-fluid" style="width: 90px; height: 90px;">
                        <p class="fs-5 fw-bold mt-2">Va li</p>
                    </div>
                </a>
                <div class="divider"></div>

                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="4" class="nav-link text-dark me-4">
                    <div class="category-item text-center">
                        <img src="assets/icon/cate_3.webp.jpg" alt="Balo" class="img-fluid" style="width: 90px; height: 90px;">
                        <p class="fs-5 fw-bold mt-2">Balo</p>
                    </div>
                </a>
                <div class="divider"></div>

                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="8" class="nav-link text-dark me-4">
                    <div class="category-item text-center">
                        <img src="assets/icon/cate_4.webp.jpg" alt="Giày dép" class="img-fluid" style="width: 90px; height: 90px;">
                        <p class="fs-5 fw-bold mt-2">Giày dép</p>
                    </div>
                </a>
                <div class="divider"></div>

                <a asp-controller="SanPham" asp-action="Index" asp-route-danhmuc="10" class="nav-link text-dark me-4">
                    <div class="category-item text-center">
                        <img src="assets/icon/cate_5.webp.jpg" alt="Đồng hồ" class="img-fluid" style="width: 90px; height: 90px;">
                        <p class="fs-5 fw-bold mt-2">Đồng hồ</p>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <!-- ========== FLASH SALE SECTION ========== -->
    <section class="flash-sale py-5" id="flash-sale">
        <div class="container">
            <!-- Title + Countdown -->
            <div class="text-center mb-4" style="color: #8B0000;">
                <h2 class="fw-bold d-flex justify-content-center align-items-center gap-2">
                    FLASH <i class="bi bi-lightning-fill"></i> SALE
                </h2>
                <div id="countdown" class="d-flex justify-content-center gap-2 mt-2">
                    <div class="time-box"><b>12</b><span>Weeks</span></div>
                    <div class="time-box"><b>18</b><span>Hours</span></div>
                    <div class="time-box"><b>46</b><span>Min</span></div>
                    <div class="time-box"><b>02</b><span>Sec</span></div>
                </div>
            </div>

            <!-- Carousel -->
            <div class="carousel p-3">
                <div id="flashSaleCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <!-- Slide 1 -->
                        <div class="carousel-item active">
                            <div class="row">
                                <!-- Product 1 -->
                                <div class="col-md-3">
                                    <div class="card text-center">
                                        <img src="assets/icon/cate_6.webp.jpg" class="card-img-top" alt="Ví da nam cao cấp">
                                        <div class="card-body">
                                            <h6 class="card-title">Ví da nam cao cấp</h6>
                                            <p class="text-danger fw-bold">450.000₫</p>
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-maSp="1" class="btn btn-danger btn-sm">Thêm vào giỏ</a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Product 2 -->
                                <div class="col-md-3">
                                    <div class="card text-center">
                                        <img src="assets/icon/cate_7.webp.jpg" class="card-img-top" alt="Va li du lịch">
                                        <div class="card-body">
                                            <h6 class="card-title">Va li du lịch 20 inch</h6>
                                            <p class="text-danger fw-bold">1.200.000₫</p>
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-maSp="4" class="btn btn-danger btn-sm">Thêm vào giỏ</a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Product 3 -->
                                <div class="col-md-3">
                                    <div class="card text-center">
                                        <img src="assets/icon/cate_8.webp.jpg" class="card-img-top" alt="Balo laptop">
                                        <div class="card-body">
                                            <h6 class="card-title">Balo laptop chống sốc</h6>
                                            <p class="text-danger fw-bold">550.000₫</p>
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-maSp="3" class="btn btn-danger btn-sm">Thêm vào giỏ</a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Product 4 -->
                                <div class="col-md-3">
                                    <div class="card text-center">
                                        <img src="assets/icon/cate_9.webp.jpg" class="card-img-top" alt="Giày da nam">
                                        <div class="card-body">
                                            <h6 class="card-title">Giày da nam công sở</h6>
                                            <p class="text-danger fw-bold">850.000₫</p>
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-maSp="11" class="btn btn-danger btn-sm">Thêm vào giỏ</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Slide 2 -->
                        <div class="carousel-item">
                            <div class="row">
                                <!-- Product 1 -->
                                <div class="col-md-3">
                                    <div class="card text-center">
                                        <img src="assets/icon/cate_10.webp.jpg" class="card-img-top" alt="Thắt lưng da">
                                        <div class="card-body">
                                            <h6 class="card-title">Thắt lưng da nam cao cấp</h6>
                                            <p class="text-danger fw-bold">280.000₫</p>
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-maSp="10" class="btn btn-danger btn-sm">Thêm vào giỏ</a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Product 2 -->
                                <div class="col-md-3">
                                    <div class="card text-center">
                                        <img src="assets/icon/cate_11.webp.jpg" class="card-img-top" alt="Kính mát">
                                        <div class="card-body">
                                            <h6 class="card-title">Kính mát thời trang</h6>
                                            <p class="text-danger fw-bold">180.000₫</p>
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-maSp="13" class="btn btn-danger btn-sm">Thêm vào giỏ</a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Product 3 -->
                                <div class="col-md-3">
                                    <div class="card text-center">
                                        <img src="assets/icon/cate_12.webp.jpg" class="card-img-top" alt="Đồng hồ nam">
                                        <div class="card-body">
                                            <h6 class="card-title">Đồng hồ đeo tay nam</h6>
                                            <p class="text-danger fw-bold">1.250.000₫</p>
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-maSp="15" class="btn btn-danger btn-sm">Thêm vào giỏ</a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Product 4 -->
                                <div class="col-md-3">
                                    <div class="card text-center">
                                        <img src="assets/icon/cate_13.webp.jpg" class="card-img-top" alt="Vòng tay da">
                                        <div class="card-body">
                                            <h6 class="card-title">Vòng tay da cá sấu</h6>
                                            <p class="text-danger fw-bold">150.000₫</p>
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-maSp="16" class="btn btn-danger btn-sm">Thêm vào giỏ</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Carousel Controls -->
                    <button class="carousel-control-prev" type="button" data-bs-target="#flashSaleCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#flashSaleCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== FEATURED PRODUCTS SECTION ========== -->
    <section class="featured-products py-5">
        <div class="container">
            <!-- Title -->
            <div class="text-center mb-4">
                <h2 class="fw-bold text-dark d-flex justify-content-center align-items-center gap-2">SẢN PHẨM NỔI BẬT</h2>
                <img src="assets/icon/iconmyabay.png" alt="Paper Plane" style="height:80px;">
            </div>

            <!-- Carousel -->
            <div id="featuredCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <!-- Slide 1 -->
                    <div class="carousel-item active">
                        <div class="row">
                            <!-- Product 1 -->
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <img src="assets/icon/cate_18.webp.jpg" class="card-img-top" alt="Ví da nam cao cấp">
                                    <div class="card-body">
                                        <h6 class="card-title">Ví da nam cao cấp</h6>
                                        <p class="text-danger fw-bold">450.000₫</p>
                                        @if (isLoggedIn)
                                        {
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-maSp="21" class="btn btn-danger btn-sm">Thêm vào giỏ</a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Auth" asp-action="DangNhap" asp-route-returnUrl="@returnUrl" class="btn btn-secondary btn-sm">Đăng nhập để mua</a>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Product 2 -->
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <img src="assets/icon/cate_10.webp.jpg" class="card-img-top" alt="Thắt lưng da thật">
                                    <div class="card-body">
                                        <h6 class="card-title">Thắt lưng da thật</h6>
                                        <p class="text-danger fw-bold">380.000₫</p>
                                        @if (isLoggedIn)
                                        {
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-maSp="22" class="btn btn-danger btn-sm">Thêm vào giỏ</a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Auth" asp-action="DangNhap" asp-route-returnUrl="@returnUrl" class="btn btn-secondary btn-sm">Đăng nhập để mua</a>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Product 3 -->
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <img src="assets/icon/cate_11.webp.jpg" class="card-img-top" alt="Kính mát thời trang">
                                    <div class="card-body">
                                        <h6 class="card-title">Kính mát thời trang</h6>
                                        <p class="text-danger fw-bold">250.000₫</p>
                                        @if (isLoggedIn)
                                        {
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-maSp="23" class="btn btn-danger btn-sm">Thêm vào giỏ</a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Auth" asp-action="DangNhap" asp-route-returnUrl="@returnUrl" class="btn btn-secondary btn-sm">Đăng nhập để mua</a>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Product 4 -->
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <img src="assets/icon/cate_12.webp.jpg" class="card-img-top" alt="Đồng hồ đeo tay nam">
                                    <div class="card-body">
                                        <h6 class="card-title">Đồng hồ đeo tay nam</h6>
                                        <p class="text-danger fw-bold">1.200.000₫</p>
                                        @if (isLoggedIn)
                                        {
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-maSp="24" class="btn btn-danger btn-sm">Thêm vào giỏ</a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Auth" asp-action="DangNhap" asp-route-returnUrl="@returnUrl" class="btn btn-secondary btn-sm">Đăng nhập để mua</a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Slide 2 -->
                    <div class="carousel-item">
                        <div class="row">
                            <!-- Product 1 -->
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <img src="assets/icon/cate_19.webp.jpg" class="card-img-top" alt="Vòng tay phong thủy">
                                    <div class="card-body">
                                        <h6 class="card-title">Vòng tay phong thủy</h6>
                                        <p class="text-danger fw-bold">180.000₫</p>
                                        @if (isLoggedIn)
                                        {
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-maSp="25" class="btn btn-danger btn-sm">Thêm vào giỏ</a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Auth" asp-action="DangNhap" asp-route-returnUrl="@returnUrl" class="btn btn-secondary btn-sm">Đăng nhập để mua</a>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Product 2 -->
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <img src="assets/icon/cate_20.webp.jpg" class="card-img-top" alt="Nhẫn bạc nam tính">
                                    <div class="card-body">
                                        <h6 class="card-title">Nhẫn bạc nam tính</h6>
                                        <p class="text-danger fw-bold">320.000₫</p>
                                        @if (isLoggedIn)
                                        {
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-maSp="26" class="btn btn-danger btn-sm">Thêm vào giỏ</a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Auth" asp-action="DangNhap" asp-route-returnUrl="@returnUrl" class="btn btn-secondary btn-sm">Đăng nhập để mua</a>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Product 3 -->
                            <div class="col-md-3">
                                <div class="card text-center">
                                    <img src="assets/icon/cate_21.webp.jpg" class="card-img-top" alt="Cà vạt lụa cao cấp">
                                    <div class="card-body">
                                        <h6 class="card-title">Cà vạt lụa cao cấp</h6>
                                        <p class="text-danger fw-bold">290.000₫</p>
                                        @if (isLoggedIn)
                                        {
                                            <a asp-controller="Cart" asp-action="AddToCart" asp-route-maSp="27" class="btn btn-danger btn-sm">Thêm vào giỏ</a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Auth" asp-action="DangNhap" asp-route-returnUrl="@returnUrl" class="btn btn-secondary btn-sm">Đăng nhập để mua</a>
                                        }
                                    </div>
                                </div>
                            </div>

