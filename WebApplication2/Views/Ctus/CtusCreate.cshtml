@model WebApplication2.Models.Ctu

@{
    ViewData["Title"] = "Thêm mới bài viết";
}

<div class="card shadow-sm mx-auto mt-4" style="max-width: 600px;">
    <div class="card-header">
        <h1 class="h4 mb-0">@ViewData["Title"]</h1>
    </div>
    <div class="card-body">
        <!-- Action name phải là "Create" vì controller có phương thức POST Create -->
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="CtuTitle" class="form-label"></label>
                <input asp-for="CtuTitle" class="form-control" />
                <span asp-validation-for="CtuTitle" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CtuImage" class="form-label">Ảnh đại diện</label>
                <input name="CtuImage" class="form-control" type="file" />
                <span asp-validation-for="CtuImage" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CtuContent" class="form-label"></label>
                <textarea asp-for="CtuContent" class="form-control" rows="5"></textarea>
                <span asp-validation-for="CtuContent" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CtuStatus" class="form-label"></label>
                <select asp-for="CtuStatus" class="form-select">
                    <option value="">-- Chọn trạng thái --</option>
                    <option value="false">Tạm ẩn</option>
                    <option value="true">Hiển thị</option>
                </select>
                <span asp-validation-for="CtuStatus" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <!-- "Index" là action GET hiển thị danh sách -->
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                <button type="submit" class="btn btn-primary">Ghi lại</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
