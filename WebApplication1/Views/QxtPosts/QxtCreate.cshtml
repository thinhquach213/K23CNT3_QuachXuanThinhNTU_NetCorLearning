@model WebApplication1.Models.QxtPost

@{
    ViewData["Title"] = "Thêm mới bài viết";
}

<div class="card shadow-sm mx-auto mt-4" style="max-width: 200px;">
    <div class="card-header">
        <h1 class="h4 mb-0">@ViewData["Title"]</h1>
    </div>
    <div class="card-body">
        <form asp-action="QxtCreate" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="QxtTitle" class="form-label"></label>
                <input asp-for="QxtTitle" class="form-control" />
                <span asp-validation-for="QxtTitle" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="QxtImage" class="form-label"></label>
                <input name="QxtImage" class="form-control" type="file" />
                <span asp-validation-for="QxtImage" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="QxtContent" class="form-label"></label>
                <textarea asp-for="QxtContent" class="form-control" rows="5"></textarea>
                <span asp-validation-for="QxtContent" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="QxtStatus" class="form-label"></label>
                <select asp-for="QxtStatus" class="form-select">
                    <option value="">-- Chọn trạng thái --</option>
                    <option value="false">Tạm ẩn</option>
                    <option value="true">Hiển thị</option>
                </select>
                <span asp-validation-for="QxtStatus" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="QxtIndex" class="btn btn-secondary">Quay lại</a>
                <button type="submit" class="btn btn-primary">Ghi lại</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
