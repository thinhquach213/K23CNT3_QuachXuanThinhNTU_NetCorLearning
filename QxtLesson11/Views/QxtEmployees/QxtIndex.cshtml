@model IEnumerable<QxtLesson11.Models.QxtEmployee>

@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="QxtCreate" class="btn btn-primary">Thêm mới nhân viên</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-light">
        <tr>
            <th>@Html.DisplayNameFor(model => model.QxtEmpId)</th>
            <th>@Html.DisplayNameFor(model => model.QxtEmpName)</th>
            <th>@Html.DisplayNameFor(model => model.QxtEmpLevel)</th>
            <th>@Html.DisplayNameFor(model => model.QxtEmpStartDate)</th>
            <th>@Html.DisplayNameFor(model => model.QxtEmpStatus)</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.QxtEmpId</td>
                <td>@item.QxtEmpName</td>
                <td>@item.QxtEmpLevel</td>
                <td>@item.QxtEmpStartDate.ToString("dd/MM/yyyy")</td>

                <td>
                    @if (item.QxtEmpStatus == true)
                    {
                        <span class="badge bg-success">Hiển thị</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Ẩn</span>
                    }
                </td>
                <td>
                    <div class="btn-group btn-group-sm" role="group">
                        <a asp-action="QxtEdit" asp-route-id="@item.QxtEmpId" class="btn btn-success">Sửa</a>
                        <a asp-action="QxtDetails" asp-route-id="@item.QxtEmpId" class="btn btn-info">Chi tiết</a>
                        <a asp-action="QxtDelete" asp-route-id="@item.QxtEmpId" class="btn btn-danger">Xóa</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
