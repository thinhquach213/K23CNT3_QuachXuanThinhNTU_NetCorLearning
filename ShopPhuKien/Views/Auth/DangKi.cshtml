@model ShopPhuKien.Models.KhachHang
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký - Phụ Kiện TDA</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        /* Shopee Color Scheme */
        :root {
            --shoppee-orange: #ee4d2d;
            --shoppee-light-orange: #ff7337;
            --shoppee-dark-orange: #d73211;
            --shoppee-bg: #f5f5f5;
            --shoppee-text: #333;
            --shoppee-light-text: #757575;
        }

        body {
            background: linear-gradient(135deg, #f53d2d, #f63);
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        .auth-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .auth-card {
            background: white;
            border-radius: 8px;
            box-shadow: 0 3px 10px 0 rgba(0, 0, 0, 0.14);
            overflow: hidden;
            width: 100%;
            max-width: 400px;
        }

        .auth-header {
            background: white;
            padding: 30px 30px 0;
            text-align: center;
        }

        .auth-logo {
            font-size: 24px;
            font-weight: 700;
            color: var(--shoppee-orange);
            margin-bottom: 20px;
        }

        .auth-title {
            font-size: 20px;
            font-weight: 600;
            color: var(--shoppee-text);
            margin-bottom: 10px;
        }

        .auth-subtitle {
            color: var(--shoppee-light-text);
            font-size: 14px;
            margin-bottom: 30px;
        }

        .auth-body {
            padding: 0 30px 30px;
        }

        .form-control {
            border: 1px solid rgba(0,0,0,.14);
            border-radius: 2px;
            padding: 12px;
            font-size: 14px;
            transition: all 0.3s;
        }

            .form-control:focus {
                border-color: var(--shoppee-orange);
                box-shadow: 0 0 0 2px rgba(238, 77, 45, 0.1);
            }

        .form-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--shoppee-text);
            margin-bottom: 8px;
        }

        .btn-shoppee {
            background: var(--shoppee-orange);
            border: none;
            color: white;
            padding: 12px;
            font-size: 14px;
            font-weight: 600;
            border-radius: 2px;
            width: 100%;
            transition: all 0.3s;
        }

            .btn-shoppee:hover {
                background: var(--shoppee-dark-orange);
                color: white;
            }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 20px 0;
            color: var(--shoppee-light-text);
            font-size: 12px;
        }

            .divider::before,
            .divider::after {
                content: '';
                flex: 1;
                border-bottom: 1px solid #dbdbdb;
            }

            .divider::before {
                margin-right: 10px;
            }

            .divider::after {
                margin-left: 10px;
            }

        .social-login {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
        }

        .social-btn {
            flex: 1;
            border: 1px solid rgba(0,0,0,.26);
            border-radius: 2px;
            padding: 10px;
            background: white;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 12px;
            color: var(--shoppee-text);
            transition: all 0.3s;
        }

            .social-btn:hover {
                background: #f8f8f8;
            }

        .auth-footer {
            text-align: center;
            padding: 20px 30px;
            background: #f5f5f5;
            border-top: 1px solid #dbdbdb;
        }

        .auth-link {
            color: var(--shoppee-orange);
            font-size: 12px;
            text-decoration: none;
            font-weight: 600;
        }

            .auth-link:hover {
                color: var(--shoppee-dark-orange);
            }

        .policy-text {
            font-size: 11px;
            color: var(--shoppee-light-text);
            text-align: center;
            margin-top: 20px;
            line-height: 1.4;
        }

        .policy-link {
            color: var(--shoppee-orange);
            text-decoration: none;
        }

        .error-message {
            background: #fff9fa;
            border: 1px solid #ff424f;
            border-radius: 2px;
            padding: 12px;
            margin-bottom: 20px;
            font-size: 12px;
            color: #ff424f;
        }

        .validation-error {
            font-size: 11px;
            color: #ff424f;
            margin-top: 4px;
            display: block;
        }

        .back-home {
            position: absolute;
            top: 20px;
            left: 20px;
            color: white;
            text-decoration: none;
            font-size: 14px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

            .back-home:hover {
                color: rgba(255,255,255,0.8);
            }
    </style>
</head>

<body>
    <a asp-controller="Home" asp-action="Index" class="back-home">
        <i class="bi bi-arrow-left"></i> Về trang chủ
    </a>

    <div class="auth-container">
        <div class="auth-card">
            <!-- Header -->
            <div class="auth-header">
                <div class="auth-logo">PHỤ KIỆN TDA</div>
                <h1 class="auth-title">Đăng Ký</h1>
                <p class="auth-subtitle">Tạo tài khoản để mua sắm dễ dàng hơn</p>
            </div>

            <!-- Body -->
            <div class="auth-body">
                @if (ViewBag.Error != null)
                {
                    <div class="error-message">
                        <i class="bi bi-exclamation-circle me-2"></i>@ViewBag.Error
                    </div>
                }

                <div asp-validation-summary="ModelOnly" class="error-message"></div>

                <form method="post" asp-controller="Auth" asp-action="DangKi">
                    @Html.AntiForgeryToken()

                    <!-- Họ tên -->
                    <div class="mb-3">
                        <label asp-for="HoTen" class="form-label">HỌ VÀ TÊN</label>
                        <input asp-for="HoTen" class="form-control" placeholder="Nhập họ và tên" required />
                        <span asp-validation-for="HoTen" class="validation-error"></span>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">EMAIL</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Nhập email" required />
                        <span asp-validation-for="Email" class="validation-error"></span>
                    </div>

                    <!-- Số điện thoại -->
                    <div class="mb-3">
                        <label asp-for="SoDienThoai" class="form-label">SỐ ĐIỆN THOẠI</label>
                        <input asp-for="SoDienThoai" class="form-control" placeholder="Nhập số điện thoại" />
                        <span asp-validation-for="SoDienThoai" class="validation-error"></span>
                    </div>

                    <!-- Địa chỉ -->
                    <div class="mb-3">
                        <label asp-for="DiaChi" class="form-label">ĐỊA CHỈ (Không bắt buộc)</label>
                        <input asp-for="DiaChi" class="form-control" placeholder="Nhập địa chỉ" />
                        <span asp-validation-for="DiaChi" class="validation-error"></span>
                    </div>

                    <!-- Mật khẩu -->
                    <div class="mb-3">
                        <label asp-for="MatKhau" class="form-label">MẬT KHẨU</label>
                        <input asp-for="MatKhau" type="password" class="form-control" placeholder="Nhập mật khẩu" required />
                        <span asp-validation-for="MatKhau" class="validation-error"></span>
                    </div>

                    <!-- Xác nhận mật khẩu -->
                    <div class="mb-4">
                        <label for="ConfirmPassword" class="form-label">XÁC NHẬN MẬT KHẨU</label>
                        <input id="ConfirmPassword" name="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu" required />
                    </div>

                    <button type="submit" class="btn-shoppee mb-3">
                        ĐĂNG KÝ
                    </button>

                    <div class="policy-text">
                        Bằng việc Đăng ký, bạn đã đồng ý với
                        <a href="#" class="policy-link">Điều khoản dịch vụ</a>
                        và
                        <a href="#" class="policy-link">Chính sách bảo mật</a>
                        của chúng tôi
                    </div>
                </form>

                <div class="divider">HOẶC</div>

                <div class="social-login">
                    <button type="button" class="social-btn">
                        <i class="bi bi-facebook" style="color: #1877f2;"></i>
                        Facebook
                    </button>
                    <button type="button" class="social-btn">
                        <i class="bi bi-google" style="color: #ea4335;"></i>
                        Google
                    </button>
                </div>
            </div>

            <!-- Footer -->
            <div class="auth-footer">
                <span style="font-size: 12px; color: var(--shoppee-light-text);">
                    Bạn đã có tài khoản?
                </span>
                <a asp-action="DangNhap" asp-controller="Auth" class="auth-link ms-1">
                    Đăng nhập
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        // Kiểm tra mật khẩu trùng khớp
        document.querySelector('form').addEventListener('submit', function (e) {
            const password = document.querySelector('#MatKhau').value;
            const confirmPassword = document.querySelector('#ConfirmPassword').value;

            if (password !== confirmPassword) {
                e.preventDefault();
                alert('Mật khẩu xác nhận không khớp!');
                return false;
            }

            if (password.length < 6) {
                e.preventDefault();
                alert('Mật khẩu phải có ít nhất 6 ký tự!');
                return false;
            }
        });

        // Hiệu ứng focus cho input
        const inputs = document.querySelectorAll('.form-control');
        inputs.forEach(input => {
            input.addEventListener('focus', function () {
                this.parentElement.classList.add('focused');
            });

            input.addEventListener('blur', function () {
                if (this.value === '') {
                    this.parentElement.classList.remove('focused');
                }
            });
        });
    </script>
</body>
</html>