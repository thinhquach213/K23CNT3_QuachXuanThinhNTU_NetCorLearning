<script>
    // Hàm tăng số lượng
    function increaseQuantity(maSp) {
        const quantityInput = document.getElementById(`quantity-${maSp}`);
        let currentValue = parseInt(quantityInput.value) || 1;
        quantityInput.value = currentValue + 1;

        updateCart(maSp, quantityInput.value);
    }

    // Hàm giảm số lượng
    function decreaseQuantity(maSp) {
        const quantityInput = document.getElementById(`quantity-${maSp}`);
        let currentValue = parseInt(quantityInput.value) || 1;
        if (currentValue > 1) {
            quantityInput.value = currentValue - 1;
            updateCart(maSp, quantityInput.value);
        }
    }

    // Cập nhật giỏ hàng bằng AJAX
    function updateCart(maSp, soLuong) {
        fetch(`/Cart/UpdateQuantity?maSp=${maSp}&soLuong=${soLuong}`, {
            method: 'POST'
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Cập nhật lại tổng tiền và thành tiền từng sản phẩm
                    location.reload();
                }
            })
            .catch(err => console.error('Lỗi cập nhật giỏ hàng:', err));
    }
</script>