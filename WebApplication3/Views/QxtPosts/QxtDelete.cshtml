@model WebApplication3.Models.QxtPost

@{
    ViewData["Title"] = "Xóa bài viết";
}

<h3>Bạn chắc chắn muốn xóa?</h3>
<div>
    <h4>QxtPost</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.QxtTitle)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.QxtTitle)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.QxtImage)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.QxtImage)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.QxtContent)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.QxtContent)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.QxtStatus)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.QxtStatus)
        </dd>
    </dl>

    <form asp-action="QxtDelete">
        <input type="hidden" asp-for="QxtId" />
        <input type="submit" value="Xóa" class="btn btn-danger" /> |
        <a asp-action="QxtIndex">Quay lại danh sách</a>
    </form>
</div>
