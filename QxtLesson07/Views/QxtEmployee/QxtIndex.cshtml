@model IEnumerable<QxtLesson07.Models.QxtEmployee>

@{
    ViewData["Title"] = "QxtIndex";
}

<h1>DANH SACH NHAN VIEN</h1>

<p>
    <a asp-action="QxtCreate" class=" btn btn-primary">Them Moi</a>
</p>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.QxtID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.QxtName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.QxtBirthDay)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.QxtEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.QxtPhone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.QxtSalary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.QxtStatus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.QxtID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.QxtName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.QxtBirthDay)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.QxtEmail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.QxtPhone)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.QxtSalary)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.QxtStatus)
            </td>
                <td>
                    @Html.ActionLink("Edit", "QxtEdit", new { id = item.QxtID }) |
                    @Html.ActionLink("Details", "Details", new { id = item.QxtID }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.QxtID })
                </td>

        </tr>
}
    </tbody>
</table>
