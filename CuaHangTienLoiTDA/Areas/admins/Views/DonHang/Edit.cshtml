@model CuaHangTienLoiTDA.Models.DonHang
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2 class="text-primary mb-3">Sửa đơn hàng</h2>

    <div class="card shadow p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="MaDH" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="MaKH" class="form-label">Khách hàng</label>
                @if (ViewBag.MaKH != null)
                {
                    <select asp-for="MaKH" class="form-control" asp-items="(SelectList)ViewBag.MaKH"></select>
                }
                else
                {
                    <input asp-for="MaKH" class="form-control" type="number" />
                }
                <span asp-validation-for="MaKH" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NgayDat" class="form-label"></label>
                <input asp-for="NgayDat" class="form-control" type="datetime-local" />
                <span asp-validation-for="NgayDat" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TongTien" class="form-label"></label>
                <input asp-for="TongTien" class="form-control" />
                <span asp-validation-for="TongTien" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TrangThai" class="form-label"></label>
                <input asp-for="TrangThai" class="form-control" />
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">← Quay lại</a>
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
