@model QxtLesson06.Models.QxtEmployee

@{
    ViewData["Title"] = "Thêm nhân viên";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewData["Title"]</h2>
    <form asp-action="QxtCreate" method="post">
        <div class="mb-3">
            <label asp-for="QxtName" class="form-label">Họ tên</label>
            <input asp-for="QxtName" class="form-control" />
            <span asp-validation-for="QxtName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="QxtBirthDay" class="form-label">Ngày sinh</label>
            <input asp-for="QxtBirthDay" class="form-control" type="date" />
            <span asp-validation-for="QxtBirthDay" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="QxtEmail" class="form-label">Email</label>
            <input asp-for="QxtEmail" class="form-control" />
            <span asp-validation-for="QxtEmail" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="QxtPhone" class="form-label">SĐT</label>
            <input asp-for="QxtPhone" class="form-control" />
            <span asp-validation-for="QxtPhone" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="QxtSalary" class="form-label">Lương</label>
            <input asp-for="QxtSalary" class="form-control" />
            <span asp-validation-for="QxtSalary" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="QxtStatus" class="form-label">Trạng thái</label>
            <select asp-for="QxtStatus" class="form-select">
                <option value="true">Hoạt động</option>
                <option value="false">Ngừng</option>
            </select>
            <span asp-validation-for="QxtStatus" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">
            <i class="bi bi-check-circle"></i> Lưu
        </button>
        <a asp-action="QxtIndex" class="btn btn-secondary">
            <i class="bi bi-x-circle"></i> Hủy
        </a>
    </form>
</div>
